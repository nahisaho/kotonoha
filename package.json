{
  "name": "kotonoha",
  "version": "0.4.2",
  "description": "GitHub Copilot CLI skills for consulting analysis, technical writing, Japanese prose, Obsidian vaults, Canvas and Bases, and PPTX planning.",
  "license": "MIT",
  "author": "nahisaho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nahisaho/kotonoha.git"
  },
  "bugs": {
    "url": "https://github.com/nahisaho/kotonoha/issues"
  },
  "homepage": "https://github.com/nahisaho/kotonoha#readme",
  "bin": {
    "kotonoha": "bin/kotonoha.js"
  },
  "scripts": {
    "test": "node --test",
    "test:ginza": "uv run skills/japanese-prose/scripts/test_engine.py",
    "test:obsidian-vault": "uv run --offline --locked --python 3.12 skills/obsidian-vault/scripts/test_vault.py",
    "test:obsidian-canvas": "uv run --offline --locked --python 3.12 skills/obsidian-canvas/scripts/test_canvas.py",
    "test:obsidian-bases": "node --test skills/obsidian-bases/scripts/verify.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "copilot",
    "github-copilot",
    "skill",
    "technical-writing",
    "consulting",
    "analysis",
    "strategy",
    "documentation",
    "markdown",
    "obsidian",
    "presentation",
    "pptx",
    "powerpoint",
    "slides"
  ],
  "files": [
    "CHANGELOG.md",
    "README-ja.md",
    "bin/",
    "skills/",
    "!skills/**/node_modules/",
    "!skills/**/__pycache__/",
    "!skills/**/*.pyc"
  ]
}
